root = true

# C# sources; checked with dotnet format (whitespace / style).
[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Existing style: explicit types, block-scoped namespaces, usings outside the namespace.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_style_namespace_declarations = block_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
# Compact but safe: a one-line body may skip braces, a body on its own line(s) needs them;
# members whose body fits on one line use =>.
csharp_prefer_braces = when_multiline:warning
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_constructors = when_on_single_line:warning
csharp_style_expression_bodied_operators = when_on_single_line:warning
csharp_style_expression_bodied_local_functions = when_on_single_line:warning
dotnet_sort_system_directives_first = true

# Formatting (IDE0055) and unnecessary usings (IDE0005) fail dotnet format style --verify-no-changes.
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0005.severity = warning

# Every analyzer rule is a warning (and the build treats warnings as errors).
dotnet_analyzer_diagnostic.severity = warning

# CA1031 (catch general exceptions) is off at the OS / hardware boundary only. WinRT, COM, MBIM,
# serial ports, PDH and the elevated helper process fail with arbitrary exception types, and each
# failure is reported as the sample's error text instead of ending the monitor (21 handlers).
# Program.cs is the last-resort handler that prints the message instead of a stack trace.
# Domain / Application / Presentation keep the rule.
[{Program.cs,Infrastructure/**.cs}]
dotnet_diagnostic.CA1031.severity = none
